---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";

const currentYear = new Date().getFullYear();

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;
---

<footer
  class:list={["app-layout py-4", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="flex flex-col items-center justify-between border-t border-border py-6 sm:flex-row sm:py-4"
  >
    <div class="my-2 flex flex-col items-center whitespace-nowrap sm:flex-row">
      <span>Copyright &#169; {currentYear}</span>
      <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
      <span>All rights reserved.</span>
    </div>
    <Socials />
  </div>
  <div
    class="flex flex-col items-center text-sm text-gray-600 sm:flex-row sm:items-start"
  >
    <a class="hover:text-black hover:underline" href="/imprint">Imprint</a>
    <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
    <a class="hover:text-black hover:underline" href="/privacy">Privacy</a>
  </div>
</footer>
